{
    "compilerOptions": {
        "target": "ES6",
        "module": "CommonJS",
        "outDir": "./build",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "baseUrl": "./",
        "paths": {
            "*": ["node_modules/*"]
        }
    },
    "include": ["codegen.ts"]
}
